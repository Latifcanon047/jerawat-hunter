# Database (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (PgBouncer) untuk runtime aplikasi
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.neon.tech/dbname?sslmode=require"

# DIRECT_URL: Direct non-pooled connection string untuk Prisma CLI / migrasi
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Auth.js (NextAuth v5)
# Generate secret dengan: npx auth secret atau openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Provider (Kandidat: Resend - akan dikonfigurasi pada tahap autentikasi)
# RESEND_API_KEY=""
